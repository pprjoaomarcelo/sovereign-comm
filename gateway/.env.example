# This is an example file. Copy it to .env and fill in your actual values.
# Do NOT commit the .env file to Git.

# Pinata API Key for IPFS pinning
PINATA_JWT="COLE_SEU_PINATA_JWT_AQUI"

# Voltage.cloud API Key for Lightning Invoices
VOLTAGE_API_KEY="COLE_SUA_VOLTAGE_API_KEY_AQUI"
VOLTAGE_NODE_ID="COLE_SEU_VOLTAGE_NODE_ID_AQUI"

# Bitcoin Testnet Wallet (Wallet Import Format) for the gateway to pay for anchor transactions
GATEWAY_BITCOIN_WIF="COLE_SUA_CHAVE_WIF_DE_TESTNET_AQUI"

# A secret key to protect your gateway's message submission endpoint
GATEWAY_API_KEY="gere_uma_chave_secreta_aqui"