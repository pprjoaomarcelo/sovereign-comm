{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext", // Mantém o modo moderno
    "moduleResolution": "NodeNext", // Mantém o modo moderno
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.tsx",
    "src/test-anchor.ts",
    "src/test-gateway.ts"
  ]
}