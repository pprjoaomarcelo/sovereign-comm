{
  // Estende a configuração principal do seu projeto
  "extends": "./src/tsconfig.json",
  "compilerOptions": {
    // Garante que o TypeScript reconheça os tipos globais do Jest (jest, expect, etc.)
    "types": ["jest", "node"]
